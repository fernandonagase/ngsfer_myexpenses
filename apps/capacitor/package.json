{
  "name": "@ngsfer-myexpenses/capacitor",
  "version": "0.7.0",
  "description": "Aplicativo para controle de finanças pessoais",
  "productName": "My Expenses",
  "author": "Fernando Nagase <nagase.fernando@gmail.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "quasar dev",
    "dev:android": "quasar dev -m capacitor -T android",
    "build": "quasar build",
    "postinstall": "quasar prepare",
    "createmigration": "typeorm migration:create"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/status-bar": "^7.0.0",
    "@capawesome/capacitor-file-picker": "^7.0.0",
    "@ngsfer-myexpenses/utils": "workspace:*",
    "@quasar/extras": "^1.16.4",
    "@vueuse/core": "^13.4.0",
    "apexcharts": "^4.4.0",
    "axios": "^1.2.1",
    "dayjs": "^1.11.13",
    "jeep-sqlite": "^2.8.0",
    "pinia": "^2.0.11",
    "quasar": "^2.16.0",
    "reflect-metadata": "^0.2.2",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.20",
    "v-money3": "^3.24.1",
    "vue": "^3.4.18",
    "vue-router": "^4.0.12",
    "vue3-apexcharts": "^1.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@quasar/app-vite": "^2.0.0",
    "@types/node": "^20.17.16",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.3",
    "autoprefixer": "^10.4.2",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "~5.5.3",
    "vite": "^7.3.1",
    "vite-plugin-checker": "^0.8.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^2.0.29"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20 || ^18",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
